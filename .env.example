# Copy this file to .env and fill in the values.

# URL of the FastAPI backend (backend/main.py). Locally: uvicorn on port 8000.
# Requests go through Next.js server actions, so this only has to be
# reachable from the Next.js server, not from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional — the defaults below are used when these are left out.
# Name of the cookie that stores the password (the backend's GAS_API_KEY).
# NEXT_PUBLIC_TOKEN_KEY=@example/token
# NEXT_PUBLIC_REFRESH_TOKEN_KEY=@example/refresh-token
# NEXT_PUBLIC_RUN_MODE=development
